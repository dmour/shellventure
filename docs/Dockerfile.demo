# Recorder for docs/demo.gif: VHS + what the game needs. Build and run from the repo root:
#   docker build -t shellventure-demo -f docs/Dockerfile.demo . && docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD":/vhs -w /vhs shellventure-demo docs/demo.tape
FROM ghcr.io/charmbracelet/vhs:v0.10.0
RUN sed -i "s/ stable/ bookworm/g" /etc/apt/sources.list.d/*.sources /etc/apt/sources.list 2>/dev/null; apt-get update -qq && apt-get install -y -qq --no-install-recommends python3-rich git jq && rm -rf /var/lib/apt/lists/*
